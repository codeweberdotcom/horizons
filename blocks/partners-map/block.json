{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "horizons-blocks/partners-map",
  "version": "1.1.0",
  "title": "Partners Map",
  "category": "horizons-blocks",
  "icon": "location",
  "description": "Display partners on a Yandex Map grouped by region and country",
  "keywords": ["partners", "map", "yandex", "regions", "countries"],
  "supports": {
    "html": false,
    "customClassName": false
  },
  "textdomain": "horizons",
  "editorScript": "file:./index.js",
  "style": "file:./style.css",
  "render": "file:./render.php",
  "attributes": {
    "dataSource": {
      "type": "string",
      "default": "both"
    },
    "height": {
      "type": "number",
      "default": 600
    },
    "zoom": {
      "type": "number",
      "default": 4
    },
    "centerLat": {
      "type": "number",
      "default": 55.76
    },
    "centerLng": {
      "type": "number",
      "default": 37.64
    },
    "mapType": {
      "type": "string",
      "default": "normal"
    },
    "scrollZoom": {
      "type": "boolean",
      "default": false
    },
    "autoFitBounds": {
      "type": "boolean",
      "default": true
    },
    "markerColor": {
      "type": "string",
      "default": "#C8A96E"
    },
    "markerSize": {
      "type": "number",
      "default": 40
    },
    "clustererEnabled": {
      "type": "boolean",
      "default": false
    },
    "sidebarEnabled": {
      "type": "boolean",
      "default": true
    },
    "sidebarPosition": {
      "type": "string",
      "default": "left"
    },
    "sidebarTitle": {
      "type": "string",
      "default": ""
    },
    "styleJson": {
      "type": "string",
      "default": ""
    },
    "markerShape": {
      "type": "string",
      "default": "circle"
    },
    "markerShowCount": {
      "type": "boolean",
      "default": true
    },
    "markerShowLabel": {
      "type": "boolean",
      "default": false
    },
    "markerLabelSize": {
      "type": "number",
      "default": 11
    },
    "markerLabelColor": {
      "type": "string",
      "default": "#1a1a1a"
    }
  }
}
